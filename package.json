{
  "name": "dofus-efficiency",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:tesseract": "node scripts/prepare-tesseract.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "predev": "npm run prepare:tesseract",
    "dev": "vite",
